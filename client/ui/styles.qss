/* QuizForge — дизайн-система (темна тема). Плейсхолдери @...@ підставляє core/ui_theme.py */

/* ---------- База ---------- */
QWidget {
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
    background: transparent;
    color: @TEXT@;
}
QMainWindow, QDialog { background-color: @BG@; }
QScrollArea { border: none; background: transparent; }
QComboBoxPrivateContainer { background-color: @SURFACE@; border: 1px solid @BORDER2@; border-radius: 8px; }
QToolTip { background-color: @BTN@; color: @TEXT@; border: 1px solid @BORDER2@; padding: 6px 8px; border-radius: 6px; }

/* ---------- Типографіка ---------- */
QLabel#titleLabel   { font-size: 24px; font-weight: 700; color: @STRONG@; }
QLabel#subtitleLabel{ font-size: 13px; color: @MUTED@; }
QLabel#logoLabel    { font-size: 18px; font-weight: 700; color: @STRONG@; }
QLabel#bodyLabel    { font-size: 16px; color: @TEXT@; }
QLabel#sectionLabel { font-size: 15px; font-weight: 600; color: @STRONG@; }
QLabel#progressLabel{ font-size: 14px; font-weight: 600; color: @MUTED@; }
QLabel#questionLabel{ font-size: 24px; font-weight: 600; color: @STRONG@; padding: 8px 0; }
QLabel#timerLabel   { font-size: 28px; font-weight: 700; color: @STRONG@; padding: 4px 14px; border-radius: 8px; }
QLabel#timerLabel[low="true"] { background-color: #B91C1C; color: #FFFFFF; }
QLabel#hintLabel    { background-color: @ACCENT_SOFT@; border: 1px solid @ACCENT@; border-radius: 8px; padding: 8px 12px; color: @HINT_TEXT@; font-size: 12px; }
QLabel#debugBar     { background: @SURFACE@; color: @MUTED@; font-family: Consolas, monospace; font-size: 11px; padding: 4px 8px; border-radius: 4px; }
QLabel#rulesLabel   { font-size: 15px; padding: 16px 18px; background-color: @INPUT@; border: 1px solid @BORDER@; border-radius: 10px; }

/* ---------- Картки ---------- */
QFrame#card, QWidget#card { background-color: @SURFACE@; border: 1px solid @BORDER@; border-radius: 12px; }
QFrame#card QLabel, QWidget#card QLabel { background: transparent; }

/* ---------- Поля ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @INPUT@;
    border: 1px solid @BORDER2@;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 22px;
    color: @TEXT@;
    selection-background-color: @ACCENT@;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDoubleSpinBox:hover, QComboBox:hover { border-color: @BORDER3@; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border: 1px solid @ACCENT@; }
QLineEdit:disabled, QTextEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: @DISABLED@; background-color: @SURFACE@; }
QLineEdit[error="true"] { border-color: @ERR_ACCENT@; }
QComboBox QAbstractItemView { background-color: @SURFACE@; border: 1px solid @BORDER2@; selection-background-color: @SELECT@; outline: none; }

/* ---------- Кнопки: за замовчуванням вторинні ---------- */
QPushButton {
    background-color: @BTN@;
    color: @TEXT@;
    border: 1px solid @BORDER2@;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
    min-height: 22px;
}
QPushButton:hover { background-color: @BTN_HOVER@; border-color: @BORDER3@; }
QPushButton:pressed { background-color: @SURFACE@; }
QPushButton:focus { border-color: @ACCENT@; }
QPushButton:disabled { background-color: @SURFACE@; color: @DISABLED@; border-color: @ROW_LINE@; }

QPushButton#primaryButton { background-color: @ACCENT@; border-color: @ACCENT@; color: #FFFFFF; font-weight: 600; }
QPushButton#primaryButton:hover { background-color: @ACCENT_HOVER@; border-color: @ACCENT_HOVER@; }
QPushButton#primaryButton:pressed { background-color: @ACCENT_PRESSED@; border-color: @ACCENT_PRESSED@; }
QPushButton#primaryButton:disabled { background-color: @SELECT@; border-color: @SELECT@; color: @DISABLED@; }

QPushButton#dangerButton { color: @ERR_FG@; }
QPushButton#dangerButton:hover { background-color: @ERR_HOVER@; border-color: @ERR_ACCENT@; }
QPushButton#dangerButton:disabled { color: @DISABLED@; }

/* ---------- Навігація адмінки ---------- */
QWidget#topbar { background-color: @INPUT@; border-bottom: 1px solid @BORDER@; }
QWidget#topbar QLabel { background: transparent; }
QPushButton#navTab {
    background: transparent; border: none; border-bottom: 2px solid transparent; border-radius: 0;
    color: @MUTED@; font-weight: 500; padding: 16px 4px; margin: 0 14px;
}
QPushButton#navTab:hover { color: @STRONG@; background: transparent; }
QPushButton#navTab:checked { color: @STRONG@; border-bottom: 2px solid @ACCENT@; }

/* ---------- Таблиці ---------- */
QTableWidget, QTableView {
    background-color: @SURFACE@;
    alternate-background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    gridline-color: transparent;
    selection-background-color: @SELECT@;
    selection-color: #FFFFFF;
    outline: none;
}
QTableWidget::item, QTableView::item { padding: 10px 14px; border: none; border-bottom: 1px solid @ROW_LINE@; }
QTableWidget::item:hover, QTableView::item:hover { background-color: @ROW_HOVER@; }
QTableWidget::item:selected, QTableView::item:selected { background-color: @SELECT@; color: @STRONG@; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background-color: transparent; color: @MUTED@; padding: 12px 14px; border: none;
    border-bottom: 1px solid @BORDER@; font-size: 12px; font-weight: 600; text-align: left;
}
QTableCornerButton::section { background: transparent; border: none; border-bottom: 1px solid @BORDER@; }

/* ---------- Списки ---------- */
QListWidget { background-color: @SURFACE@; border: 1px solid @BORDER@; border-radius: 10px; outline: none; padding: 4px; }
QListWidget::item { padding: 10px 12px; border-radius: 8px; }
QListWidget::item:hover { background-color: @ROW_HOVER@; }
QListWidget::item:selected { background-color: @SELECT@; color: @STRONG@; }

/* ---------- Групи ---------- */
QGroupBox { background-color: @SURFACE@; border: 1px solid @BORDER@; border-radius: 12px; margin-top: 0; padding: 46px 16px 16px 16px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: padding; subcontrol-position: top left; left: 16px; top: 14px; color: @STRONG@; background: transparent; }

/* ---------- Чекбокси та радіо (SVG-індикатори з акцентом) ---------- */
QCheckBox, QRadioButton { spacing: 12px; }
QCheckBox::indicator, QRadioButton::indicator { width: 20px; height: 20px; border: none; background: transparent; }
QRadioButton::indicator:unchecked { image: url(@ICONS@/radio-off.svg); }
QRadioButton::indicator:unchecked:hover { image: url(@ICONS@/radio-off-hover.svg); }
QRadioButton::indicator:checked { image: url(@ICONS@/radio-on.svg); }
QCheckBox::indicator:unchecked { image: url(@ICONS@/check-off.svg); }
QCheckBox::indicator:unchecked:hover { image: url(@ICONS@/check-off-hover.svg); }
QCheckBox::indicator:checked { image: url(@ICONS@/check-on.svg); }
QCheckBox:disabled, QRadioButton:disabled { color: @DISABLED@; }

/* ---------- Варіанти відповідей у тесті (картки) ---------- */
QRadioButton#optionCard, QCheckBox#optionCard {
    font-size: 17px; padding: 18px 22px; spacing: 16px; min-height: 28px;
    background-color: @SURFACE@; border: 1px solid @BORDER2@; border-radius: 12px;
}
QRadioButton#optionCard:hover, QCheckBox#optionCard:hover { border-color: @BORDER3@; background-color: @BTN@; }
QRadioButton#optionCard:checked, QCheckBox#optionCard:checked { border: 1px solid @ACCENT@; background-color: @ACCENT_SOFT@; color: @STRONG@; }
QRadioButton#optionCard:focus, QCheckBox#optionCard:focus { border-color: @ACCENT@; }

/* ---------- Прогрес, скрол, спліттер, статус ---------- */
QProgressBar { background: @BORDER@; border: none; border-radius: 3px; max-height: 6px; min-height: 6px; text-align: center; color: transparent; }
QProgressBar::chunk { background: @ACCENT@; border-radius: 3px; }
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: @BORDER3@; border-radius: 4px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @RING@; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: @BORDER3@; border-radius: 4px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: @RING@; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QSplitter::handle { background: transparent; }
QStatusBar { background: @INPUT@; color: @MUTED@; }
QMenu { background-color: @SURFACE@; border: 1px solid @BORDER2@; padding: 4px; }
QMenu::item { padding: 8px 20px; border-radius: 6px; }
QMenu::item:selected { background-color: @SELECT@; }

/* ---------- Списки, що випадають, і лічильники (власні стрілки) ---------- */
QComboBox { padding-right: 36px; }
QComboBox::drop-down { border: none; width: 34px; subcontrol-origin: padding; subcontrol-position: center right; }
QComboBox::down-arrow { image: url(@ICONS@/chevron-down.svg); width: 12px; height: 12px; }
QSpinBox, QDoubleSpinBox { padding-right: 30px; }
QSpinBox::up-button, QDoubleSpinBox::up-button { subcontrol-origin: border; subcontrol-position: top right; width: 26px; height: 18px; border: none; background: transparent; }
QSpinBox::down-button, QDoubleSpinBox::down-button { subcontrol-origin: border; subcontrol-position: bottom right; width: 26px; height: 18px; border: none; background: transparent; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow { image: url(@ICONS@/chevron-up.svg); width: 10px; height: 10px; }
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow { image: url(@ICONS@/chevron-down.svg); width: 10px; height: 10px; }

/* ---------- Діалоги ---------- */
QDialog#themed { background-color: @BG@; }
QLabel#dialogTitle { font-size: 18px; font-weight: 600; color: @STRONG@; }
QLabel#dialogText { font-size: 14px; color: @TEXT2@; }
QLabel#fieldLabel { font-size: 12px; font-weight: 500; color: @MUTED@; }
QLabel#errorLabel { font-size: 13px; color: @ERR_FG@; background-color: @ERR_HOVER@; border: 1px solid @ERR_BORDER@; border-radius: 8px; padding: 8px 12px; }
QLabel#dialogIcon { min-width: 44px; max-width: 44px; min-height: 44px; max-height: 44px; border-radius: 22px; font-size: 22px; font-weight: 700; qproperty-alignment: AlignCenter; }
QLabel#dialogIcon[kind="info"] { background-color: @INFO_BG@; color: @INFO_FG@; }
QLabel#dialogIcon[kind="question"] { background-color: @INFO_BG@; color: @INFO_FG@; }
QLabel#dialogIcon[kind="warn"] { background-color: @WARN_BG@; color: @WARN_FG@; }
QLabel#dialogIcon[kind="error"] { background-color: @ERR_BG@; color: @ERR_FG@; }
QLabel#dialogIcon[kind="ok"] { background-color: @OK_BG@; color: @OK_FG@; }
QFrame#divider { background-color: @BORDER@; border: none; min-height: 1px; max-height: 1px; }
QPushButton#ghostButton { background: transparent; border: none; color: @MUTED@; padding: 6px 10px; min-width: 0; }
QPushButton#ghostButton:hover { color: @STRONG@; background: transparent; }
QFrame#statCard { background-color: @SURFACE@; border: 1px solid @BORDER@; border-radius: 12px; }
QLabel#statValue { font-size: 28px; font-weight: 700; color: @STRONG@; }
QLabel#statValue[kind="ok"] { color: @OK_FG@; }
QLabel#statValue[kind="warn"] { color: @WARN_FG@; }
QLabel#statValue[kind="bad"] { color: @ERR_FG@; }

/* ---------- Екран тесту ---------- */
QWidget#quizTopbar { background-color: @INPUT@; border-bottom: 1px solid @BORDER@; }
QWidget#quizFooter { background-color: @INPUT@; border-top: 1px solid @BORDER@; }
QWidget#quizTopbar QLabel, QWidget#quizFooter QLabel { background: transparent; }
QLabel#questionMeta { font-size: 13px; font-weight: 500; color: @MUTED@; }
QLabel#userLabel { font-size: 13px; color: @MUTED@; }
QLabel#recDot { color: @OK_DOT@; font-size: 12px; }
QPushButton#navButton { min-height: 28px; padding: 10px 26px; font-size: 15px; }
QLineEdit#openAnswer { font-size: 17px; padding: 14px 16px; border-radius: 12px; }
QLineEdit#codeInput { font-size: 26px; font-weight: 600; letter-spacing: 10px; border-radius: 12px; }
QLabel#ruleIcon { min-width: 24px; max-width: 24px; min-height: 24px; max-height: 24px; border-radius: 12px; background-color: @ERR_BG@; color: @ERR_FG@; font-size: 12px; font-weight: 700; }
QLabel#thumb { border: 1px solid @BORDER2@; border-radius: 8px; padding: 2px; }

/* ---------- Іконкові кнопки (✕, ↑, ↓) ---------- */
QPushButton#iconButton { padding: 0; min-width: 0; font-size: 14px; }
QPushButton#iconButton:hover { color: @ERR_FG@; border-color: @ERR_ACCENT@; }
QFrame#card QListWidget, QFrame#card QTextEdit { background-color: @INPUT@; }

/* ---------- Перемикач теми ---------- */
QPushButton#themeToggle { background: transparent; border: 1px solid @BORDER2@; border-radius: 16px; padding: 4px 14px; min-height: 22px; color: @MUTED@; font-size: 13px; }
QPushButton#themeToggle:hover { color: @STRONG@; border-color: @BORDER3@; background: @BTN_HOVER@; }


/* Рядок варіанту відповіді */
QWidget#optionRow {
    background: transparent;
}
QPushButton#iconButton {
    background-color: transparent;
    border: 1px solid #2F3D55;
    border-radius: 8px;
    color: #9AA8BD;
    font-size: 16px;
}
QPushButton#iconButton:hover {
    background-color: #1A2332;
    color: #FCA5A5;
    border-color: #FCA5A5;
}


QPushButton#dangerIconButton {
    background-color: transparent;
    border: 1px solid #7F2A33;
    border-radius: 8px;
    color: #FCA5A5;
    font-size: 16px;
}
QPushButton#dangerIconButton:hover {
    background-color: #3A1D22;
    color: #F87171;
    border-color: #F87171;
}
