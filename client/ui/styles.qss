/* QuizForge — дизайн-система. Гнучкі розміри + захист від накладання */

/* ---------- База ---------- */
QWidget {
    font-family: "Inter", "Segoe UI Variable", "Segoe UI", "Noto Sans", sans-serif;
    font-size: 14px;
    background: transparent;
    color: @TEXT@;
}
QMainWindow, QDialog { background-color: @BG@; }
QScrollArea { border: none; background: transparent; }
QToolTip {
    background-color: @BTN@;
    color: @TEXT@;
    border: 1px solid @BORDER2@;
    padding: 6px 10px;
    border-radius: 6px;
    font-size: 12px;
}

/* ---------- Типографіка (гнучка) ---------- */
QLabel#titleLabel   { font-size: 22px; font-weight: 700; color: @STRONG@; }
QLabel#subtitleLabel{ font-size: 13px; color: @MUTED@; }
QLabel#logoLabel    { font-size: 16px; font-weight: 700; color: @STRONG@; }
QLabel#sectionLabel { font-size: 14px; font-weight: 600; color: @STRONG@; }
QLabel#fieldLabel   { font-size: 12px; font-weight: 500; color: @MUTED@; }

/* ---------- Картки (гнучкі) ---------- */
QFrame#card, QWidget#card {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    min-width: 180px;
}
QFrame#card QLabel, QWidget#card QLabel { background: transparent; }

/* ---------- Поля (гнучкі) ---------- */
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: @INPUT@;
    border: 1px solid @BORDER2@;
    border-radius: 8px;
    padding: 8px 12px;
    min-height: 20px;
    min-width: 60px;
    color: @TEXT@;
}
QLineEdit:focus, QTextEdit:focus { border: 1px solid @ACCENT@; }

/* ---------- Кнопки (гнучкі) ---------- */
QPushButton {
    background-color: @BTN@;
    color: @TEXT@;
    border: 1px solid @BORDER2@;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: 500;
    min-height: 20px;
    min-width: 40px;
}
QPushButton:hover { background-color: @BTN_HOVER@; }
QPushButton#primaryButton { background-color: @ACCENT@; border-color: @ACCENT@; color: #FFFFFF; }
QPushButton#dangerButton { color: @ERR_FG@; }
QPushButton#dangerButton:hover { background-color: @ERR_HOVER@; border-color: @ERR_ACCENT@; }

/* ---------- Іконкові кнопки ---------- */
QPushButton#iconBtn {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 6px;
    min-width: 32px;
    min-height: 32px;
    max-width: 40px;
    max-height: 40px;
}
QPushButton#iconBtn:hover {
    background-color: @BTN_HOVER@;
    border-color: @BORDER@;
}
QPushButton#iconBtn[danger="true"]:hover {
    background-color: #3A1D22;
    border-color: #F87171;
}
QPushButton#iconBtn[accent="true"]:hover {
    background-color: rgba(59, 130, 246, 0.15);
    border-color: #3b82f6;
}

/* ---------- Таблиці (гнучкі) ---------- */
QTableWidget, QTableView {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 12px;
    selection-background-color: @SELECT@;
    outline: none;
}
QTableWidget::item { padding: 8px 12px; border-bottom: 1px solid @ROW_LINE@; }
QHeaderView::section {
    background: transparent;
    color: @MUTED@;
    padding: 10px 12px;
    border: none;
    border-bottom: 1px solid @BORDER@;
    font-size: 12px;
    font-weight: 600;
}

/* ---------- Списки ---------- */
QListWidget {
    background-color: @SURFACE@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    outline: none;
    padding: 4px;
    min-width: 120px;
}
QListWidget::item { padding: 8px 10px; border-radius: 6px; }
QListWidget::item:hover { background-color: @ROW_HOVER@; }
QListWidget::item:selected { background-color: @SELECT@; }

/* ---------- Скрол (тонкий) ---------- */
QScrollBar:vertical { background: transparent; width: 8px; margin: 2px; }
QScrollBar::handle:vertical { background: @BORDER3@; border-radius: 4px; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: @RING@; }
QScrollBar:horizontal { background: transparent; height: 8px; margin: 2px; }
QScrollBar::handle:horizontal { background: @BORDER3@; border-radius: 4px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }

/* ---------- Навігація ---------- */
QWidget#topbar { background-color: @INPUT@; border-bottom: 1px solid @BORDER@; min-height: 48px; }
QPushButton#navTab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: @MUTED@;
    font-weight: 500;
    padding: 12px 8px;
    margin: 0 8px;
}
QPushButton#navTab:hover { color: @STRONG@; }
QPushButton#navTab:checked { color: @STRONG@; border-bottom: 2px solid @ACCENT@; }

/* ---------- Діалоги ---------- */
QDialog { background-color: @BG@; min-width: 300px; }
QLabel#dialogTitle { font-size: 16px; font-weight: 600; color: @STRONG@; }
QLabel#dialogText { font-size: 13px; color: @TEXT2@; }
QLabel#errorLabel {
    font-size: 12px;
    color: @ERR_FG@;
    background-color: @ERR_HOVER@;
    border: 1px solid @ERR_BORDER@;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ---------- Варіанти відповідей ---------- */
QWidget#optionRow {
    background: transparent;
    min-height: 44px;
}
QWidget#optionRow QLineEdit {
    min-width: 100px;
}

/* ---------- Перемикач теми ---------- */
QPushButton#themeToggle {
    background: transparent;
    border: 1px solid @BORDER2@;
    border-radius: 14px;
    padding: 4px 12px;
    color: @MUTED@;
    font-size: 12px;
}
QPushButton#themeToggle:hover { color: @STRONG@; border-color: @BORDER3@; }

/* ---------- Чекбокси ---------- */
QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator { width: 18px; height: 18px; }

/* ---------- Спліттер ---------- */
QSplitter::handle { background: @BORDER@; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
